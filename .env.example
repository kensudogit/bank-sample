# Copy to .env and change the passwords (local development only)
ORACLE_PASSWORD=change_me_sys
BANK_DB_USER=BANK
BANK_DB_PASSWORD=change_me_bank
ORACLE_HOST_PORT=1521
LIBERTY_HOST_PORT=9080
FRONTEND_HOST_PORT=3000

# 外部連携（Kong・MuleSoft・OAuth・mTLS など）の秘密情報は生成して追記する:
#   bash integration/scripts/gen-secrets.sh >> .env
# MULE_CORE_PASSWORD=<サービスアカウント svc-mule のパスワード>
# PUBLIC_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# AI アシスタント（Claude）：bash integration/scripts/gen-agent-secrets.sh >> .env と、Anthropic のコンソールで発行したキー
# ANTHROPIC_API_KEY=<Claude API のキー>
# コスト・課金で Railway の使用量を取り込むとき（任意）：RAILWAY_API_TOKEN=<アカウントのトークン>・RAILWAY_PROJECT_ID=<プロジェクト ID>
