<?xml version="1.0" encoding="UTF-8"?>
<!--
  System API 相当：勘定系（Struts 2 / Liberty）の API 呼び出しを 1 か所にまとめる。
  - サービスアカウント svc-mule（ロール INTEGRATION）でログインし、セッション Cookie を Object Store に保持する
  - セッション切れ（401）なら 1 回だけログインし直して再実行する（401 は処理前に拒否された要求なので、再送しても二重実行にならない）
  - 呼び出し元は vars.corePath（例 /remit-incoming）と payload（JSON）を渡し、勘定系の data 部分を受け取る
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <!-- サービスアカウントでログインし、応答の Set-Cookie（JSESSIONID）を保存する -->
  <sub-flow name="core-login" doc:name="勘定系にログイン">
    <http:request method="POST" config-ref="Core_Banking_API" path="${core.basePath}/login" doc:name="POST /login">
      <http:body><![CDATA[#[output application/json --- { userId: p('core.user'), password: p('core.password') }]]]></http:body>
      <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
    </http:request>
    <set-variable variableName="coreCookie" doc:name="Cookie を取り出す"
      value="#[((attributes.headers['set-cookie'] default '') splitBy ';')[0]]"/>
    <os:store key="core-session" objectStore="Core_Session_Store" doc:name="保存">
      <os:value><![CDATA[#[vars.coreCookie]]]></os:value>
    </os:store>
  </sub-flow>

  <!-- 勘定系の更新系 API を呼ぶ（入力: vars.corePath・payload／出力: payload = 勘定系の data） -->
  <flow name="core-post" doc:name="勘定系 API（POST）">
    <set-variable variableName="coreRequest" value="#[payload]" doc:name="要求を退避"/>
    <os:retrieve key="core-session" objectStore="Core_Session_Store" target="coreCookie" doc:name="保存済みセッション">
      <os:default-value><![CDATA[#[""]]]></os:default-value>
    </os:retrieve>
    <choice doc:name="未ログインならログイン">
      <when expression="#[isEmpty(vars.coreCookie)]">
        <flow-ref name="core-login"/>
      </when>
    </choice>
    <!-- 応答コードで分岐する（業務エラー 4xx は入力の問題として 422、401 は 1 回だけ再ログイン、5xx は 502） -->
    <try doc:name="勘定系を呼ぶ">
      <flow-ref name="core-send" doc:name="送信"/>
      <choice doc:name="セッション切れなら再ログイン">
        <when expression="#[attributes.statusCode == 401]">
          <flow-ref name="core-login"/>
          <flow-ref name="core-send" doc:name="再送"/>
        </when>
      </choice>
      <choice doc:name="結果の判定">
        <when expression="#[attributes.statusCode &gt;= 200 and attributes.statusCode &lt; 300 and payload.error == null]">
          <logger level="DEBUG" message="#['core ' ++ vars.corePath ++ ' ' ++ attributes.statusCode]"/>
        </when>
        <when expression="#[attributes.statusCode &gt;= 400 and attributes.statusCode &lt; 500]">
          <set-variable variableName="problemErrors" value="#[[{ line: 0, message: payload.error.message default ('HTTP ' ++ attributes.statusCode) }]]"/>
          <raise-error type="APP:INVALID_INPUT" description="勘定系が要求を受け付けませんでした。"/>
        </when>
        <otherwise>
          <raise-error type="APP:CORE_UNAVAILABLE" description="勘定系 API でエラーが発生しました。"/>
        </otherwise>
      </choice>
      <error-handler>
        <on-error-propagate type="HTTP:CONNECTIVITY, HTTP:TIMEOUT" doc:name="接続できない">
          <raise-error type="APP:CORE_UNAVAILABLE" description="勘定系 API に接続できません。"/>
        </on-error-propagate>
      </error-handler>
    </try>
    <ee:transform doc:name="data を取り出す">
      <ee:message><ee:set-payload><![CDATA[%dw 2.0 output application/java --- payload.data]]></ee:set-payload></ee:message>
    </ee:transform>
  </flow>

  <!-- 1 回の送信。応答コードは判定せずそのまま返す（判定は core-post で行う） -->
  <sub-flow name="core-send" doc:name="勘定系へ送信">
    <http:request method="POST" config-ref="Core_Banking_API" path="#[p('core.basePath') ++ vars.corePath]">
      <http:body><![CDATA[#[output application/json --- vars.coreRequest]]]></http:body>
      <http:headers><![CDATA[#[{ "Content-Type": "application/json", "Cookie": vars.coreCookie, "X-Request-ID": vars.requestId default "" }]]]></http:headers>
      <http:response-validator>
        <http:success-status-code-validator values="100..599"/>
      </http:response-validator>
    </http:request>
  </sub-flow>

  <!-- 勘定系の死活（/health は認証不要） -->
  <sub-flow name="core-health" doc:name="勘定系の死活">
    <try>
      <http:request method="GET" config-ref="Core_Banking_API" path="${core.basePath}/health" target="coreHealth"
                    responseTimeout="3000"/>
      <set-variable variableName="coreStatus" value="UP"/>
      <error-handler>
        <on-error-continue type="ANY"><set-variable variableName="coreStatus" value="DOWN"/></on-error-continue>
      </error-handler>
    </try>
  </sub-flow>
</mule>
