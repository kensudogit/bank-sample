# Kong Gateway（OSS 3.9・DB-less）の宣言的設定。起動時に render-config.sh が __*__ を環境変数の値に置き換えて
# /tmp/kong.yml を作る（鍵・証明書・共有シークレットをリポジトリに書かない）。
#
#   ブラウザ → frontend →（Host: kong）kong:8000 /bank/api/* → liberty（共有シークレットを付け直して転送）
#   連携先 → kong /oauth2/token（クライアントクレデンシャル）→ auth（トークン発行）
#   連携先 → kong /integration/v1/*（Bearer トークン：署名・iss・aud・exp・roles）→ mule:8443（mTLS）→ kong → liberty
#   画面 → kong /agent/v1/runs（行員の委任トークン）→ agent（Claude）→ kong /agent/v1/bank/*（On-Behalf-Of のトークン）→ liberty
#   全要求の記録（http-log）→ liberty /bank/api/usage-ingest（課金の配賦・コスト予測）
#
# - レート制限は Redis で Kong の全台が共有する（policy: redis。Redis が止まっても通信は止めない＝fault_tolerant）
# - AUTH_MODE=entra なら、発行者・宛先・公開鍵・クライアント ID を Microsoft Entra ID の値にする（render-config.sh）
_format_version: "3.0"
_transform: true

upstreams:
  # 勘定系 API（WebSphere Liberty）。能動（/health）と受動（接続失敗・5xx）の両方で異常な台を外す
  - name: liberty.upstream
    algorithm: round-robin
    healthchecks:
      active:
        type: http
        http_path: /bank/api/health
        timeout: 2
        healthy: { interval: 5, successes: 2 }
        unhealthy: { interval: 5, http_failures: 2, tcp_failures: 2, timeouts: 2, http_statuses: [500, 502, 503, 504] }
      passive:
        healthy: { successes: 3 }
        unhealthy: { tcp_failures: 2, timeouts: 3, http_failures: 3, http_statuses: [502, 503, 504] }
    targets: __LIBERTY_TARGETS__

# MuleSoft のサーバー証明書を検証する社内 CA と、Kong が MuleSoft に示すクライアント証明書（mTLS）
ca_certificates:
  - id: 6f0e3f7a-1d3b-4c55-9a51-0b6b1f3e9a01
    cert: "__MTLS_CA_CERT__"
certificates:
  - id: 2b8f1c4e-5d6a-4e7b-8c9d-0a1b2c3d4e02
    cert: "__MTLS_CLIENT_CERT__"
    key: "__MTLS_CLIENT_KEY__"

services:
  # ---------------- 勘定系 API（画面用・MuleSoft 用） ----------------
  - name: bank-core-api
    host: liberty.upstream
    port: 9080
    protocol: http
    connect_timeout: 1000
    read_timeout: 30000
    write_timeout: 30000
    # 接続失敗時のみ別の台で再試行する（更新系は冪等キー付きなので、届いていた場合も二重実行されない）
    retries: 2
    plugins:
      # ゲートウェイ迂回の防止：送信元が付けた同名ヘッダーを消してから、Liberty と共有するシークレットを付ける
      # 送信元が付けた識別ヘッダー（X-Bank-Auth など。Agent のルートでだけ Kong が検証済みのトークンから付ける）も消す
      - name: request-transformer
        config:
          remove: { headers: ["X-Bank-Gateway-Secret", "X-Bank-Auth", "X-Bank-Delegated-User", "X-Bank-Delegated-Oid", "X-Bank-Agent-Id", "X-Bank-Scopes", "X-Bank-Roles", "X-Bank-Token-Id", "X-Bank-Tenant"] }
          add: { headers: ["X-Bank-Gateway-Secret:__GATEWAY_SECRET__"] }
    routes:
      # Kong だけが使う勘定系の内部 API（使用量の記録・Agent のメーター）は、画面の経路からは呼べない
      - name: bank-core-internal-only
        hosts: __INTERNAL_HOSTS__
        paths: ["/bank/api/usage-ingest", "/bank/api/agent-usage", "/bank/api/agent-budget"]
        strip_path: false
        plugins:
          - name: request-termination
            config: { status_code: 404, message: "Not Found" }
      # ログインは IP ごとに厳しく制限する（Liberty 側の 5 回失敗ロックに加えた総当たり対策）
      - name: bank-core-login
        hosts: __INTERNAL_HOSTS__
        paths: ["/bank/api/login"]
        strip_path: false
        methods: ["POST"]
        plugins:
          - name: rate-limiting
            config: { minute: 20, limit_by: ip, __RATE_LIMIT_STORE__ }
      # 手動送信の登録（Base64 で最大 5 MB のデータを含むため、上限を別にする）
      - name: bank-core-integration-upload
        hosts: __INTERNAL_HOSTS__
        paths: ["/bank/api/integration-request-create"]
        strip_path: false
        methods: ["POST"]
        plugins:
          - name: request-size-limiting
            config: { allowed_payload_size: 8, size_unit: megabytes }
      # 画面と MuleSoft からの API。社内の名前（KONG_INTERNAL_HOSTS）に限り、外向けの入口からは呼べない
      - name: bank-core-api
        hosts: __INTERNAL_HOSTS__
        paths: ["/bank/api"]
        strip_path: false
        plugins:
          - name: rate-limiting
            config: { minute: 1200, limit_by: ip, __RATE_LIMIT_STORE__ }
          - name: request-size-limiting
            config: { allowed_payload_size: 1, size_unit: megabytes }

  # ---------------- OAuth 2.0 トークン発行（AUTH_MODE=local のときだけ使う） ----------------
  - name: oauth-token
    url: http://__AUTH_HOST__:8080/oauth2/token
    routes:
      - name: oauth-token
        paths: ["/oauth2/token"]
        strip_path: true
        methods: ["POST"]
    plugins:
      - name: rate-limiting
        config: { minute: 30, limit_by: ip, __RATE_LIMIT_STORE__ }
      - name: request-size-limiting
        config: { allowed_payload_size: 8, size_unit: kilobytes }

  # ---------------- 外部連携（MuleSoft Process API。mTLS） ----------------
  - name: integration-zengin
    url: https://__MULE_HOST__:8443/api/v1/zengin
    read_timeout: 60000
    tls_verify: true
    ca_certificates: [6f0e3f7a-1d3b-4c55-9a51-0b6b1f3e9a01]
    client_certificate: { id: 2b8f1c4e-5d6a-4e7b-8c9d-0a1b2c3d4e02 }
    routes:
      - name: integration-zengin
        paths: ["/integration/v1/zengin"]
        strip_path: true
        methods: ["POST"]
    plugins:
      - name: jwt
        config: &jwt_conf { key_claim_name: azp, claims_to_verify: [exp, nbf], maximum_expiration: 3600, header_names: [authorization], uri_param_names: [], cookie_names: [] }
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__TOKEN_AUDIENCE__"], required_roles: ["Zengin.Submit", "Ops.Submit"] }
      - name: acl
        config: { allow: ["zengin-network", "bank-ops"], hide_groups_header: true }
      - name: rate-limiting
        config: { minute: 30, limit_by: consumer, __RATE_LIMIT_STORE__ }
      - name: request-size-limiting
        config: { allowed_payload_size: 5, size_unit: megabytes }
      - name: request-transformer
        config: { remove: { headers: ["X-Bank-Operator"] } }

  - name: integration-billing
    url: https://__MULE_HOST__:8443/api/v1/billing
    read_timeout: 60000
    tls_verify: true
    ca_certificates: [6f0e3f7a-1d3b-4c55-9a51-0b6b1f3e9a01]
    client_certificate: { id: 2b8f1c4e-5d6a-4e7b-8c9d-0a1b2c3d4e02 }
    routes:
      - name: integration-billing
        paths: ["/integration/v1/billing"]
        strip_path: true
        methods: ["POST"]
    plugins:
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__TOKEN_AUDIENCE__"], required_roles: ["Billing.Submit", "Ops.Submit"] }
      - name: acl
        config: { allow: ["billing-agency", "bank-ops"], hide_groups_header: true }
      - name: rate-limiting
        config: { minute: 30, limit_by: consumer, __RATE_LIMIT_STORE__ }
      - name: request-size-limiting
        config: { allowed_payload_size: 5, size_unit: megabytes }
      - name: request-transformer
        config: { remove: { headers: ["X-Bank-Operator"] } }

  - name: integration-fx
    url: https://__MULE_HOST__:8443/api/v1/fx
    tls_verify: true
    ca_certificates: [6f0e3f7a-1d3b-4c55-9a51-0b6b1f3e9a01]
    client_certificate: { id: 2b8f1c4e-5d6a-4e7b-8c9d-0a1b2c3d4e02 }
    routes:
      - name: integration-fx
        paths: ["/integration/v1/fx"]
        strip_path: true
        methods: ["POST"]
    plugins:
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__TOKEN_AUDIENCE__"], required_roles: ["Fx.Submit", "Ops.Submit"] }
      - name: acl
        config: { allow: ["fx-provider", "bank-ops"], hide_groups_header: true }
      - name: rate-limiting
        config: { minute: 60, limit_by: consumer, __RATE_LIMIT_STORE__ }
      - name: request-size-limiting
        config: { allowed_payload_size: 64, size_unit: kilobytes }
      - name: request-transformer
        config: { remove: { headers: ["X-Bank-Operator"] } }

  # ---------------- AI Agent（Claude）。行員の委任 → On-Behalf-Of → 勘定系の参照 API ----------------
  # 画面のサーバー側 → Agent：行員の委任トークン（aud=api://bank-agent・scp=Agent.Invoke）。行員ごとに 1 分 10 回
  - name: agent-runs
    url: http://__AGENT_HOST__:8090/v1/runs
    read_timeout: 180000
    routes:
      - name: agent-runs
        paths: ["/agent/v1/runs"]
        strip_path: true
        methods: ["POST"]
    plugins:
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__AGENT_AUDIENCE__"], token_type: delegated, required_scopes: ["Agent.Invoke"], allowed_tenants: ["__TENANT_ID__"], forward_identity: true }
      - name: acl
        config: { allow: ["console"], hide_groups_header: true }
      - name: rate-limiting
        config: { minute: 10, limit_by: header, header_name: X-Bank-Delegated-Oid, __RATE_LIMIT_STORE__ }
      - name: request-size-limiting
        config: { allowed_payload_size: 16, size_unit: kilobytes }

  # Agent → 勘定系の参照 API：On-Behalf-Of のトークン（aud=api://bank-core・azp=Agent・行員の oid・委任スコープ）。
  # Kong が検証済みのクレームを X-Bank-* にして Liberty に渡し、Liberty は「行員の権限 ∩ Agent のスコープ」で判定する。参照（GET）だけ
  - name: agent-core-api
    host: liberty.upstream
    port: 9080
    protocol: http
    path: /bank/api
    connect_timeout: 1000
    read_timeout: 30000
    routes:
      - name: agent-core-api
        paths: ["/agent/v1/bank"]
        strip_path: true
        methods: ["GET"]
    plugins:
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__CORE_AUDIENCE__"], token_type: delegated, required_scopes: ["Accounts.Read", "Transactions.Read", "Customers.Read", "Fx.Read"], allowed_tenants: ["__TENANT_ID__"], forward_identity: true }
      - name: acl
        config: { allow: ["agents"], hide_groups_header: true }
      - name: rate-limiting
        config: { minute: 120, limit_by: consumer, __RATE_LIMIT_STORE__ }
      - name: request-transformer
        config:
          remove: { headers: ["X-Bank-Gateway-Secret"] }
          add: { headers: ["X-Bank-Gateway-Secret:__GATEWAY_SECRET__"] }

  # Agent のメーター（アプリのみのトークン・ロール Agent.Meter）：実行と LLM のトークン数の記録、予算の確認
  - name: agent-meter-usage
    host: liberty.upstream
    port: 9080
    protocol: http
    path: /bank/api/agent-usage
    routes:
      - name: agent-meter-usage
        paths: ["/agent/v1/meter/usage"]
        strip_path: true
        methods: ["POST"]
    plugins: &agent_meter_plugins
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__TOKEN_AUDIENCE__"], token_type: app, required_roles: ["Agent.Meter"], allowed_tenants: ["__TENANT_ID__"], forward_identity: true }
      - name: acl
        config: { allow: ["agents"], hide_groups_header: true }
      - name: request-transformer
        config:
          remove: { headers: ["X-Bank-Gateway-Secret"] }
          add: { headers: ["X-Bank-Gateway-Secret:__GATEWAY_SECRET__"] }

  - name: agent-meter-budget
    host: liberty.upstream
    port: 9080
    protocol: http
    path: /bank/api/agent-budget
    routes:
      - name: agent-meter-budget
        paths: ["/agent/v1/meter/budget"]
        strip_path: true
        methods: ["GET"]
    plugins: *agent_meter_plugins

  # ゲートウェイ自体の死活

  # ゲートウェイ自体の死活（Railway などのヘルスチェック用。上流へは転送しない）
  - name: gateway-health
    url: http://127.0.0.1:65535
    routes:
      - name: gateway-health
        paths: ["/gateway-health"]
        methods: ["GET"]
    plugins:
      - name: request-termination
        config: { status_code: 200, message: "ok" }

  # 稼働状況：有効なトークンがあれば誰でも（連携先の疎通確認用）
  - name: integration-health
    url: https://__MULE_HOST__:8443/api/v1/health
    tls_verify: true
    ca_certificates: [6f0e3f7a-1d3b-4c55-9a51-0b6b1f3e9a01]
    client_certificate: { id: 2b8f1c4e-5d6a-4e7b-8c9d-0a1b2c3d4e02 }
    routes:
      - name: integration-health
        paths: ["/integration/v1/health"]
        strip_path: true
        methods: ["GET"]
    plugins:
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__TOKEN_AUDIENCE__"], required_roles: [] }

  # 実行履歴：銀行の運用（連携コンソール）だけ
  - name: integration-runs
    url: https://__MULE_HOST__:8443/api/v1/runs
    tls_verify: true
    ca_certificates: [6f0e3f7a-1d3b-4c55-9a51-0b6b1f3e9a01]
    client_certificate: { id: 2b8f1c4e-5d6a-4e7b-8c9d-0a1b2c3d4e02 }
    routes:
      - name: integration-runs
        paths: ["/integration/v1/runs"]
        strip_path: true
        methods: ["GET"]
    plugins:
      - name: jwt
        config: *jwt_conf
      - name: bank-token-claims
        config: { issuer: "__TOKEN_ISSUER__", audiences: ["__TOKEN_AUDIENCE__"], required_roles: ["Ops.Read"] }
      - name: acl
        config: { allow: ["bank-ops"], hide_groups_header: true }

# 全ルート共通：要求 ID（X-Request-ID）の付与と応答への返却、Prometheus 指標（ステータス用ポート 8100 の /metrics）、
# 分散トレース（KONG_OTEL_ENDPOINT を設定したときだけ OpenTelemetry で送る）
plugins:
  - name: correlation-id
    config: { header_name: X-Request-ID, generator: uuid, echo_downstream: true }
  - name: prometheus
    config: { status_code_metrics: true, latency_metrics: true, upstream_health_metrics: true, per_consumer: true, bandwidth_metrics: true }
__OTEL_PLUGIN__
__METERING_PLUGIN__

# 連携先（API の利用者）。キーはトークンの azp（クライアント ID）。グループ（ACL）で呼べる API を限定する
consumers:
  - username: zengin-network
    custom_id: partner-zengin
    jwt_secrets: [{ key: "__CLIENT_ID_ZENGIN__", algorithm: RS256, rsa_public_key: "__TOKEN_PUBLIC_KEY__" }]
    acls: [{ group: zengin-network }]
  - username: billing-agency
    custom_id: partner-billing
    jwt_secrets: [{ key: "__CLIENT_ID_BILLING__", algorithm: RS256, rsa_public_key: "__TOKEN_PUBLIC_KEY__" }]
    acls: [{ group: billing-agency }]
  - username: fx-provider
    custom_id: partner-fx
    jwt_secrets: [{ key: "__CLIENT_ID_FX__", algorithm: RS256, rsa_public_key: "__TOKEN_PUBLIC_KEY__" }]
    acls: [{ group: fx-provider }]
  # 銀行の運用（画面の連携コンソールからサーバー側で使う。ブラウザにはトークンもシークレットも渡さない）
  - username: bank-ops
    custom_id: internal-ops
    jwt_secrets: [{ key: "__CLIENT_ID_OPS__", algorithm: RS256, rsa_public_key: "__TOKEN_PUBLIC_KEY__" }]
    acls: [{ group: bank-ops }]
  # 画面（行員の委任トークンで Agent を呼ぶ）
  - username: bank-console
    custom_id: internal-console
    jwt_secrets: [{ key: "__CLIENT_ID_CONSOLE__", algorithm: RS256, rsa_public_key: "__TOKEN_PUBLIC_KEY__" }]
    acls: [{ group: console }]
  # AI Agent（On-Behalf-Of のトークンで勘定系を参照、アプリのみのトークンでメーター）
  - username: bank-agent
    custom_id: agent-bank-assistant
    jwt_secrets: [{ key: "__CLIENT_ID_AGENT__", algorithm: RS256, rsa_public_key: "__TOKEN_PUBLIC_KEY__" }]
    acls: [{ group: agents }]
