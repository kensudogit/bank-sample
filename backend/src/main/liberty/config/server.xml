<?xml version="1.0" encoding="UTF-8"?>
<!-- IBM WebSphere Application Server Liberty configuration for the bank API -->
<server description="bank-api">

  <featureManager>
    <feature>servlet-4.0</feature>
    <!-- Struts 2 core references the JSP API (javax.servlet.jsp) at startup even for JSON-only actions -->
    <feature>jsp-2.3</feature>
    <feature>jdbc-4.2</feature>
    <feature>jndi-1.0</feature>
    <!-- HTTP sessions are stored in Oracle so that any instance behind the load balancer can serve a logged-in user -->
    <feature>sessionDatabase-1.0</feature>
  </featureManager>

  <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="-1"/>

  <!-- Oracle JDBC driver (copied by the Dockerfile from the Gradle 'copyJdbcDriver' task) -->
  <library id="oracleJdbcLib">
    <fileset dir="${shared.resource.dir}/jdbc" includes="ojdbc*.jar"/>
  </library>

  <!-- Container-managed connection pool, looked up by the application as jdbc/bankDS -->
  <!--
    statementCacheSize: keeps every prepared SQL of the app (about 8) parsed per connection (default is 10)
    queryTimeout:       a statement stuck on a row lock or a slow DB releases its pooled connection instead of
                        holding it until all connections are exhausted
  -->
  <dataSource id="bankDS" jndiName="jdbc/bankDS" type="javax.sql.DataSource" isolationLevel="TRANSACTION_READ_COMMITTED"
              statementCacheSize="30" queryTimeout="30s">
    <jdbcDriver libraryRef="oracleJdbcLib"/>
    <!-- Fail fast when the DB host is unreachable instead of hanging request threads -->
    <properties.oracle URL="${env.BANK_DB_URL}" user="${env.BANK_DB_USER}" password="${env.BANK_DB_PASSWORD}"
                       connectionProperties="oracle.net.CONNECT_TIMEOUT=5000"/>
    <!--
      minPoolSize: warm connections so the first requests after start / idle periods skip the Oracle logon
      purgePolicy: after a DB restart, drop all stale connections at once rather than failing one request each
    -->
    <connectionManager minPoolSize="5" maxPoolSize="20" connectionTimeout="10s" maxIdleTime="10m"
                       agedTimeout="30m" purgePolicy="EntirePool"/>
  </dataSource>

  <webApplication id="bank-api" location="bank-api.war" contextRoot="/bank"/>

  <!--
    Login session cookie: HttpOnly (not readable by scripts), SameSite=Lax (not sent on cross-site POSTs),
    path "/" so the browser also sends it through the Next.js proxy (/api/bank/*).
    Set cookieSecure="true" once the site is served over HTTPS.
  -->
  <!--
    Session persistence (high availability): sessions are written to the BANK schema (table created by Liberty) at the
    end of each request, so a request can go to another instance after a failure or restart without logging the user out.
    It uses its own non-transactional data source, as Liberty recommends for session persistence.
  -->
  <dataSource id="sessionDS" jndiName="jdbc/sessionDS" type="javax.sql.DataSource" transactional="false">
    <jdbcDriver libraryRef="oracleJdbcLib"/>
    <properties.oracle URL="${env.BANK_DB_URL}" user="${env.BANK_DB_USER}" password="${env.BANK_DB_PASSWORD}"
                       connectionProperties="oracle.net.CONNECT_TIMEOUT=5000"/>
    <connectionManager minPoolSize="1" maxPoolSize="10" connectionTimeout="10s" purgePolicy="EntirePool"/>
  </dataSource>
  <httpSessionDatabase id="sessionDB" dataSourceRef="sessionDS" writeFrequency="END_OF_SERVLET_SERVICE"
                       writeContents="ALL_SESSION_ATTRIBUTES" tableName="BANK_HTTP_SESSIONS"/>

  <httpSession storageRef="sessionDB" cookieName="BANKSESSION" cookieHttpOnly="true" cookieSameSite="Lax" cookiePath="/"
               cookieSecure="false"/>

  <applicationManager autoExpand="true"/>
  <!-- Do not reveal server details in error pages / headers -->
  <webContainer disableXPoweredBy="true"/>
  <logging consoleLogLevel="INFO" traceSpecification="*=info"/>
</server>
