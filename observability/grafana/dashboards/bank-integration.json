{
  "uid": "bank-integration",
  "title": "bank-sample 外部連携（Kong × MuleSoft）",
  "timezone": "Asia/Tokyo",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Kong 要求数（サービス別・1 分あたり）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (service) (rate(kong_http_requests_total[5m])) * 60", "legendFormat": "{{service}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Kong 応答コード（4xx・5xx）",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (code) (rate(kong_http_requests_total{code=~\"4..|5..\"}[5m])) * 60", "legendFormat": "{{code}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Kong 遅延 p95（ms・サービス別）",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(kong_request_latency_ms_bucket[5m])))", "legendFormat": "{{service}}" }]
    },
    {
      "id": 4, "type": "stat", "title": "Liberty の正常な台数",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(kong_upstream_target_health{upstream=\"liberty.upstream\", state=\"healthy\"})" }]
    },
    {
      "id": 5, "type": "stat", "title": "トークン発行の失敗（1 時間）",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(auth_token_failures_total[1h]))" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "連携の実行（種類・結果別）",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (kind, outcome) (increase(mule_integration_runs_total[15m]))", "legendFormat": "{{kind}} {{outcome}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "勘定系の呼び出し（再試行・障害）と再送の再現",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(mule_core_calls_total[15m]))", "legendFormat": "core {{result}}" },
        { "refId": "B", "expr": "sum(increase(mule_idempotent_replays_total[15m]))", "legendFormat": "replay" }
      ]
    }
  ]
}
